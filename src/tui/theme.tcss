App {
    background: #0d0d0d;
    color: #e0e0e0;
}

AppHeader {
    height: 1;
    dock: top;
    background: #1a0000;
}

AppHeader #header-layout {
    layout: horizontal;
    width: 100%;
}

AppHeader #header-clock {
    width: 25%;
    color: #888888;
    padding-left: 1;
    content-align: left middle;
}

AppHeader #header-title {
    width: 50%;
    text-style: bold;
    color: #ff4444;
    content-align: center middle;
}

AppHeader #header-status {
    width: 25%;
    color: #ff6666;
    padding-right: 2;
    content-align: right middle;
}

Tabs {
    background: #141414;
    height: 2;
}

Tab {
    padding: 0 3;
    color: #555555;
}

Screen.-narrow Tab {
    padding: 0 1;
}

Tab.-active {
    color: #ff6666;
    background: #1e1e1e;
    text-style: bold underline;
}

Tab:hover {
    color: #cccccc;
    background: #1a1a1a;
}

#main-content {
    height: 1fr;
}

VideoListPanel {
    width: 9fr;
    min-width: 40;
    border-right: solid #2a2a2a;
    background: #0f0f0f;
}

#list-loading-anim {
    height: 1fr;
    content-align: center middle;
    color: #ff6666;
    display: none;
}

#list-view {
    height: 1fr;
    background: #0f0f0f;
    scrollbar-color: #ff4444;
    scrollbar-background: #1a1a1a;
    scrollbar-color-hover: #ff6666;
}

VideoListItem {
    padding: 1 2;
    height: auto;
    border-left: thick #0f0f0f;
}

VideoListItem:hover {
    background: #191924;
    border-left: thick #555555;
}

#list-view > VideoListItem.-highlight {
    background: #16162a;
    border-left: thick #ff4444;
    color: #ffffff;
}

VideoListItem > Static {
    background: transparent;
}

#list-loading {
    height: 1;
    background: #0f0f0f;
    color: #444444;
    padding: 0 2;
    display: block;
}

#list-loading.hidden {
    display: none;
}

#list-breadcrumb {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    color: #6699cc;
    padding: 0 1;
}

DetailPanel {
    width: 11fr;
    min-width: 30;
    background: #0a0a0a;
}

#thumbnail-area {
    height: 25;
    background: #050505;
    border-bottom: solid #2a2a2a;
    align: center middle;
    overflow: hidden;
}

ThumbnailWidget {
    width: 100%;
    height: 100%;
    background: #050505;
    content-align: center middle;
    align: center middle;
}

ThumbnailWidget > #thumb-image {
    width: auto;
    height: 100%;
}

#thumb-status {
    width: 100%;
    height: 100%;
    content-align: center middle;
    color: #444444;
}

#video-info {
    height: 1fr;
    overflow-y: auto;
    padding: 1 2;
    scrollbar-color: #ff4444;
    scrollbar-background: #0a0a0a;
    scrollbar-color-hover: #ff6666;
}

#video-title {
    color: #ffffff;
    text-style: bold;
    margin-bottom: 1;
    width: 100%;
}

#video-channel {
    color: #ff6666;
    text-style: bold;
}

#video-stats {
    color: #888888;
    margin-bottom: 1;
}

#video-file {
    color: #666666;
    margin-bottom: 1;
}

#video-desc-header {
    color: #444444;
    margin-top: 1;
}

#video-desc {
    color: #777777;
    margin-bottom: 1;
}

#video-playlists {
    color: #6699cc;
}

ActionBar {
    background: #0d0d14;
    border: solid #2a2a2a;
    border-title-color: #555555;
    border-title-style: dim;
    margin: 0 1 1 1;
    padding: 0 1;
}

ActionBar #np-title-line { height: 1; margin-top: 1; color: #ffffff; }
ActionBar #np-time-line { height: 1; color: #666666; }
ActionBar #np-keys { height: 1; color: #888888; }

Footer {
    background: #141414;
    color: #555555;
    height: 1;
}

FooterKey .footer-key--key {
    color: #ff4444;
    background: #200000;
}

FooterKey .footer-key--description {
    color: #888888;
}

Scrollbar > .scrollbar--thumb { background: #ff4444; }
Scrollbar > .scrollbar--thumb:hover { background: #ff6666; }

#debug-log {
    height: 12;
    background: #050505;
    border-top: solid #333333;
    border-bottom: solid #333333;
    color: #888888;
    padding: 0 1;
}

ChannelScreen {
    background: #0d0d0d;
}

#ch-main {
    height: 1fr;
}

ChannelInfoPanel {
    width: 22%;
    border-right: solid #2a2a2a;
    background: #0f0f0f;
    padding: 1 1;
    height: 1fr;
    overflow-y: auto;
}

#ch-name {
    text-style: bold;
    color: #ff6666;
    margin-bottom: 0;
}

#ch-subs { color: #888888; margin-bottom: 0; }
#ch-url { color: #666666; margin-bottom: 1; }
#ch-stats { color: #888888; margin-bottom: 0; }
#ch-desc-hint { color: #666666; }
#ch-sep { color: #333333; margin-bottom: 1; }

#ch-desc-scroll {
    height: 1fr;
    max-height: 20;
}

#ch-desc { color: #aaaaaa; }
#ch-thumbnail { height: 10; width: 100%; margin-bottom: 1; }

#ch-center {
    width: 45%;
    height: 1fr;
}

#ch-tabs { height: 2; }

#ch-video-list {
    height: 1fr;
    width: 100%;
    border-right: solid #2a2a2a;
}

#ch-detail-panel {
    width: 33%;
    background: #0a0a0a;
}

Screen.-narrow ChannelInfoPanel {
    display: none;
}

Screen.-narrow #ch-center {
    width: 55%;
}

Screen.-narrow #ch-detail-panel {
    width: 45%;
}

/* Every modal is centered; every dialog box shares .dialog: sizes to its content, never taller or wider than 90% of the screen, scrolls inside when it must. */
ModalScreen {
    align: center middle;
}

.dialog {
    height: auto;
    max-height: 90%;
    max-width: 90%;
    min-width: 36;
    overflow-y: auto;
    background: #1a1a1a;
    border: solid #444444;
    padding: 1 2;
}

/* A list inside a dialog grows with its rows, then scrolls: half the screen at most leaves room for the title and hint. */
.dialog-list {
    height: auto;
    max-height: 50vh;
}

#vaction-dialog, #settings-dialog, #dlpick-dialog {
    background: #111118;
}

#help-outer {
    width: 80%;
    height: 90%;
    max-width: 100;
    background: #0f0f18;
    border: solid #ff4444;
    border-title-color: #ff4444;
    border-title-style: bold;
}

#help-scroll {
    width: 100%;
    height: 1fr;
    padding: 1 3;
    overflow-y: auto;
}

#help-content {
    width: 100%;
}

#search-dialog { width: 60%; }
#download-dialog { width: 70%; }
#playlist-dialog { width: 50%; }
#quality-dialog { width: 55%; }
#vaction-dialog { width: 56; }
#settings-dialog { width: 60%; height: 80%; }
#dlpick-dialog { width: 55; }

#queue-dialog { width: 70%; }

#queue-title {
    color: #ff4444;
    text-style: bold;
    margin-bottom: 1;
}

#queue-hint {
    color: #555555;
    margin-top: 1;
}

#queue-list {
    background: #0a0a12;
    border: solid #2a2a2a;
}

#search-title, #download-title, #playlist-title, #quality-title, #settings-title {
    color: #ff4444;
    text-style: bold;
    margin-bottom: 1;
}

#search-hint, #playlist-hint, #quality-hint, #vaction-hint, #settings-hint, #dlpick-hint {
    color: #555555;
}

#settings-hint, #dlpick-hint {
    margin-top: 1;
}

#search-suggestions {
    height: auto;
    margin-top: 1;
}

#search-input {
    background: #0d0d0d;
    border: solid #444444;
    color: #ffffff;
    margin-bottom: 1;
}

#search-input:focus {
    border: solid #ff4444;
}

#download-status {
    color: #aaaaaa;
    height: 2;
    margin-bottom: 1;
}

ProgressBar {
    width: 100%;
    margin-bottom: 1;
}

ProgressBar Bar {
    width: 1fr;
}

ProgressBar .bar--bar, ProgressBar .bar--complete {
    color: #ff4444;
}

#playlist-list, #quality-list {
    background: #0d0d0d;
    border: solid #333333;
    margin-bottom: 1;
}

#imgwarn-list, #emptyfeed-list,
#ytdlp-update-list {
    height: auto;
    background: #0d0d0d;
    border: solid #333333;
}

#vaction-list {
    background: #0a0a12;
    border: solid #2a2a2a;
    margin-bottom: 1;
}

#settings-list {
    height: 1fr;
    background: #0a0a12;
    border: solid #2a2a2a;
}

#dlpick-list {
    background: #111118;
    border: none;
}

#playlist-list > ListItem,
#quality-list > ListItem,
#imgwarn-list > ListItem,
#emptyfeed-list > ListItem,
#ytdlp-update-list > ListItem {
    padding: 0 1;
    color: #888888;
    border-left: thick #0d0d0d;
}

#vaction-list > ListItem,
#settings-list > ListItem {
    padding: 0 1;
    color: #888888;
    border-left: thick #0a0a12;
}

#imgwarn-list > ListItem,
#emptyfeed-list > ListItem,
#ytdlp-update-list > ListItem,
#vaction-list > ListItem,
#settings-list > ListItem {
    height: 1;
}

#dlpick-list > ListItem {
    padding: 0 1;
}

#playlist-list > ListItem > Static,
#quality-list > ListItem > Static,
#imgwarn-list > ListItem > Static,
#emptyfeed-list > ListItem > Static,
#ytdlp-update-list > ListItem > Static,
#vaction-list > ListItem > Static,
#settings-list > ListItem > Static {
    background: transparent;
}

#playlist-list > ListItem.-highlight,
#quality-list > ListItem.-highlight,
#vaction-list > ListItem.-highlight,
#settings-list > ListItem.-highlight {
    background: #1e0a0a;
    border-left: thick #ff4444;
    color: #ffffff;
}

#imgwarn-list > ListItem.-highlight,
#emptyfeed-list > ListItem.-highlight,
#ytdlp-update-list > ListItem.-highlight {
    background: #1e1e00;
    border-left: thick #dddd00;
    color: #ffffff;
}

#dlpick-list > ListItem.-highlight {
    background: #16162a;
    border-left: thick #ff4444;
}

#playlist-list > ListItem.-highlight > Static,
#quality-list > ListItem.-highlight > Static,
#imgwarn-list > ListItem.-highlight > Static,
#emptyfeed-list > ListItem.-highlight > Static,
#ytdlp-update-list > ListItem.-highlight > Static,
#vaction-list > ListItem.-highlight > Static,
#settings-list > ListItem.-highlight > Static,
#dlpick-list > ListItem.-highlight > Static {
    color: #ffffff;
}

#watch-dialog {
    width: 65%;
    background: #0d0d0d;
    border: solid #ff4444;
}

#watch-dialog #np-header {
    color: #ff4444;
    text-style: bold;
    margin-bottom: 1;
}

#np-title {
    color: #ffffff;
    text-style: bold;
    margin-bottom: 0;
}

#np-channel {
    color: #ff6666;
    margin-bottom: 1;
}

#np-time {
    color: #aaaaaa;
    margin-bottom: 1;
}

#np-hint {
    color: #555555;
    margin-top: 1;
}

#imgwarn-dialog, #emptyfeed-dialog, #ytdlp-update-dialog {
    width: 56;
    background: #1a1a1a;
    border: solid #888800;
}

#imgwarn-title, #emptyfeed-title, #ytdlp-update-title {
    color: #dddd00;
    text-style: bold;
    margin-bottom: 1;
}

#imgwarn-body, #emptyfeed-body, #ytdlp-update-body {
    color: #aaaaaa;
    margin-bottom: 1;
}

#nav-dialog, #sort-dialog, #ch-tab-dialog {
    width: 36;
    background: #141414;
    border: solid #ff4444;
}

#nav-title, #sort-title, #ch-tab-title {
    color: #ff4444;
    text-style: bold;
    margin-bottom: 1;
    text-align: center;
    height: 1;
}

.nav-row {
    height: 1;
    color: #cccccc;
    padding: 0 1;
}

.nav-row:hover {
    background: #2a2a2a;
    color: #ffffff;
}

#nav-hint, #sort-hint, #ch-tab-hint {
    color: #555555;
    margin-top: 1;
    text-align: center;
    height: 1;
}

#vaction-title {
    color: #ffffff;
    text-style: bold;
    margin-bottom: 0;
}

#vaction-channel {
    color: #666666;
    margin-bottom: 1;
}

#settings-path, #settings-status {
    color: #888888;
    height: auto;
}

#settings-input {
    margin-top: 1;
}

#settings-list > ListItem.settings-section {
    border-left: thick #0a0a12;
    color: #ff6666;
    text-style: bold;
    background: transparent;
}

#settings-list > ListItem.settings-section:disabled > Static {
    color: #ff6666;
    text-style: bold;
}

#settings-list > ListItem:disabled {
    opacity: 1;
}

#dlpick-video-title {
    color: #ffffff;
    text-style: bold;
    margin-bottom: 0;
}

#dlpick-header {
    color: #ff4444;
    text-style: bold;
    margin-bottom: 0;
}

#dlpick-sub {
    color: #888888;
    margin-bottom: 1;
}

/* Crimson is the base above; the other themes override it through an App class set by the settings modal. */

App.theme-amber AppHeader { background: #1a0d00; color: #e8820c; }
App.theme-amber #header-title, App.theme-amber AppHeader #header-status { color: #e8820c; }
App.theme-amber Tab.-active { color: #e8820c; background: #1e1800; }
App.theme-amber Tab:hover { background: #181200; }
App.theme-amber #list-view > VideoListItem.-highlight { background: #1a1200; border-left: thick #e8820c; }
App.theme-amber VideoListItem:hover { background: #141000; }
App.theme-amber #quality-list > ListItem.-highlight,
App.theme-amber #playlist-list > ListItem.-highlight,
App.theme-amber #vaction-list > ListItem.-highlight,
App.theme-amber #settings-list > ListItem.-highlight,
App.theme-amber #dlpick-list > ListItem.-highlight { background: #1a0e00; border-left: thick #e8820c; }
App.theme-amber #list-view, App.theme-amber #video-info { scrollbar-color: #e8820c; scrollbar-color-hover: #ffb84d; }
App.theme-amber #search-input:focus { border: solid #e8820c; }
App.theme-amber #list-loading-anim, App.theme-amber #search-title, App.theme-amber #download-title, App.theme-amber #quality-title, App.theme-amber #playlist-title,
App.theme-amber #queue-title, App.theme-amber #settings-title, App.theme-amber #nav-title, App.theme-amber #sort-title, App.theme-amber #ch-tab-title, App.theme-amber #dlpick-header, App.theme-amber #video-channel, App.theme-amber #ch-name,
App.theme-amber #watch-dialog #np-header { color: #e8820c; }
App.theme-amber FooterKey .footer-key--key { color: #e8820c; background: #1a0d00; }
App.theme-amber #help-outer, App.theme-amber #nav-dialog, App.theme-amber #sort-dialog, App.theme-amber #ch-tab-dialog { border: solid #e8820c; }
App.theme-amber #watch-dialog { background: #1a0d00; border: solid #e8820c; }
App.theme-amber ProgressBar .bar--bar, App.theme-amber ProgressBar .bar--complete { color: #e8820c; }
App.theme-amber Scrollbar > .scrollbar--thumb { background: #e8820c; }
App.theme-amber Scrollbar > .scrollbar--thumb:hover { background: #ffb84d; }

App.theme-ocean AppHeader { background: #001622; color: #0ea5e9; }
App.theme-ocean #header-title, App.theme-ocean AppHeader #header-status { color: #0ea5e9; }
App.theme-ocean Tab.-active { color: #0ea5e9; background: #001520; }
App.theme-ocean Tab:hover { background: #001020; }
App.theme-ocean #list-view > VideoListItem.-highlight { background: #001a24; border-left: thick #0ea5e9; }
App.theme-ocean VideoListItem:hover { background: #00141c; }
App.theme-ocean #quality-list > ListItem.-highlight,
App.theme-ocean #playlist-list > ListItem.-highlight,
App.theme-ocean #vaction-list > ListItem.-highlight,
App.theme-ocean #settings-list > ListItem.-highlight,
App.theme-ocean #dlpick-list > ListItem.-highlight { background: #001525; border-left: thick #0ea5e9; }
App.theme-ocean #list-view, App.theme-ocean #video-info { scrollbar-color: #0ea5e9; scrollbar-color-hover: #38bdf8; }
App.theme-ocean #search-input:focus { border: solid #0ea5e9; }
App.theme-ocean #list-loading-anim, App.theme-ocean #search-title, App.theme-ocean #download-title, App.theme-ocean #quality-title, App.theme-ocean #playlist-title,
App.theme-ocean #queue-title, App.theme-ocean #settings-title, App.theme-ocean #nav-title, App.theme-ocean #sort-title, App.theme-ocean #ch-tab-title, App.theme-ocean #dlpick-header, App.theme-ocean #video-channel, App.theme-ocean #ch-name,
App.theme-ocean #watch-dialog #np-header { color: #0ea5e9; }
App.theme-ocean FooterKey .footer-key--key { color: #0ea5e9; background: #001622; }
App.theme-ocean #help-outer, App.theme-ocean #nav-dialog, App.theme-ocean #sort-dialog, App.theme-ocean #ch-tab-dialog { border: solid #0ea5e9; }
App.theme-ocean #watch-dialog { background: #001622; border: solid #0ea5e9; }
App.theme-ocean ProgressBar .bar--bar, App.theme-ocean ProgressBar .bar--complete { color: #0ea5e9; }
App.theme-ocean Scrollbar > .scrollbar--thumb { background: #0ea5e9; }
App.theme-ocean Scrollbar > .scrollbar--thumb:hover { background: #38bdf8; }

App.theme-midnight AppHeader { background: #0d0018; color: #a855f7; }
App.theme-midnight #header-title, App.theme-midnight AppHeader #header-status { color: #a855f7; }
App.theme-midnight Tab.-active { color: #a855f7; background: #0e0020; }
App.theme-midnight Tab:hover { background: #0a0018; }
App.theme-midnight #list-view > VideoListItem.-highlight { background: #160a28; border-left: thick #a855f7; }
App.theme-midnight VideoListItem:hover { background: #100820; }
App.theme-midnight #quality-list > ListItem.-highlight,
App.theme-midnight #playlist-list > ListItem.-highlight,
App.theme-midnight #vaction-list > ListItem.-highlight,
App.theme-midnight #settings-list > ListItem.-highlight,
App.theme-midnight #dlpick-list > ListItem.-highlight { background: #130a22; border-left: thick #a855f7; }
App.theme-midnight #list-view, App.theme-midnight #video-info { scrollbar-color: #a855f7; scrollbar-color-hover: #c084fc; }
App.theme-midnight #search-input:focus { border: solid #a855f7; }
App.theme-midnight #list-loading-anim, App.theme-midnight #search-title, App.theme-midnight #download-title, App.theme-midnight #quality-title, App.theme-midnight #playlist-title,
App.theme-midnight #queue-title, App.theme-midnight #settings-title, App.theme-midnight #nav-title, App.theme-midnight #sort-title, App.theme-midnight #ch-tab-title, App.theme-midnight #dlpick-header, App.theme-midnight #video-channel, App.theme-midnight #ch-name,
App.theme-midnight #watch-dialog #np-header { color: #a855f7; }
App.theme-midnight FooterKey .footer-key--key { color: #a855f7; background: #0d0018; }
App.theme-midnight #help-outer, App.theme-midnight #nav-dialog, App.theme-midnight #sort-dialog, App.theme-midnight #ch-tab-dialog { border: solid #a855f7; }
App.theme-midnight #watch-dialog { background: #0d0018; border: solid #a855f7; }
App.theme-midnight ProgressBar .bar--bar, App.theme-midnight ProgressBar .bar--complete { color: #a855f7; }
App.theme-midnight Scrollbar > .scrollbar--thumb { background: #a855f7; }
App.theme-midnight Scrollbar > .scrollbar--thumb:hover { background: #c084fc; }

/* Notifications: dialog colours, a thick accent bar like the list highlight, top right under the tab bar. */
ToastRack {
    dock: top;
    align: right top;
    margin: 3 1 0 0;
    scrollbar-size-vertical: 0;
}

Toast {
    width: auto;
    min-width: 24;
    max-width: 50;
    margin-top: 0;
    padding: 0 1;
    background: #141414;
    color: #e0e0e0;
    border: solid #333333;
    border-left: thick #ff4444;
}

Toast.-warning { border-left: thick #ddc800; }
Toast.-error { border: solid #ff4444; border-left: thick #ff4444; color: #ffb3b3; }
App.theme-amber Toast.-information { border-left: thick #e8820c; }
App.theme-ocean Toast.-information { border-left: thick #0ea5e9; }
App.theme-midnight Toast.-information { border-left: thick #a855f7; }

LibraryRail {
    width: 24;
    height: 1fr;
    background: #0f0f0f;
    border-right: solid #2a2a2a;
}

LibraryRail.-narrow {
    dock: top;
    width: 100%;
    height: 1;
    border-right: none;
}
